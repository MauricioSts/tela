# Copie para .env e preencha com valores reais. O server.js lê estas variáveis
# e as injeta no room.html em tempo de request; o systemd carrega via EnvironmentFile.
TELA_TOKEN=troque-por-um-token-aleatorio
TELA_TURN_URL=turn:tela.mauriciosts.com:3478?transport=udp
TELA_TURN_USER=telauser
TELA_TURN_PASSWORD=troque-pela-senha-do-turn

# Opcional: webhook(s) do Discord avisados quando alguém começa a transmitir a tela
# Aceita vários, separados por vírgula
TELA_DISCORD_WEBHOOK=
# Opcional: usado nos links do aviso (padrão https://tela.mauriciosts.com)
TELA_SITE_URL=
